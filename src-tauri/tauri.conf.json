{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recorte",
  "version": "0.1.2",
  "identifier": "dev.recorte.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Recorte",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/Recorte/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MTM5QUM4RUI5MkMyOTIKUldTU3dwTHJ5Sm9UeENxaUdUWmFSZHZxcjlGTnE1amxTeVlJNm5zNEF5WTUrYXNQQnN6alFZUmoK",
      "endpoints": [
        "https://github.com/flackback/recorte/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
